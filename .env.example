# Maestro'D — copy to .env for docker compose
# Enige externe dependency in compose: host LLM (LM Studio / oMLX)

# ── Local Builder (oMLX) — NIET voor docker compose
# API key hardcoded in scripts/local_builder.py: Mikey
# Zie docs/builder-session.md

# ── Product LLM (threat pipeline — tm-agent container)
# Voorlopig default: zelfde oMLX + Gemma 4 12B als Builder (:8002)
# Alternatief: LM Studio op :1234 met groter model (Qwen 27B)
#
# Dit blok is de FALLBACK: zodra je in de UI (/settings) provider profielen
# aanmaakt en aan een rol koppelt (threats / sentry), wint die configuratie.
# MODEL_PROVIDER bepaalt het provider-type van de fallback:
#   ollama | lmstudio | omlx | local | openai_compatible -> openai_compatible
#   openai | anthropic (claude) | gemini (google)        -> cloud provider
MODEL_PROVIDER=ollama
LOCAL_MODEL=gemma-4-12B-it-8bit
INFERENCE_BASE_URL=http://host.docker.internal:8002/v1
INFERENCE_API_KEY=Mikey

# ── Cloud provider keys (optioneel)
# Sleutels staan NOOIT in de database. Een provider profiel bewaart alleen de
# NAAM van de environment variabele (api_key_env); de waarde blijft hier.
# Toegestane namen: INFERENCE_API_KEY of elke LLM_* variabele.
# LLM_OPENAI_API_KEY=sk-...
# LLM_ANTHROPIC_API_KEY=sk-ant-...
# LLM_GEMINI_API_KEY=...

# ── Database
POSTGRES_USER=maestro
POSTGRES_PASSWORD=maestro
POSTGRES_DB=maestro_d
DATABASE_URL=postgresql://maestro:maestro@postgres:5432/maestro_d

# ── Storage (no MinIO)
DIAGRAM_STORAGE_PATH=/data/diagrams

# ── App
LOCAL_USER=local-user
LOG_LEVEL=INFO

# ── Security (optional — leave INTERNAL_API_KEY empty for local UI mutations)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# INTERNAL_API_KEY=change-me-if-sentry-only-hardening
# VITE_INTERNAL_API_KEY=change-me-if-sentry-only-hardening
# API_RATE_LIMIT_ENABLED=false

# ── Frontend (npm run dev)
VITE_APP_ENDPOINT=http://localhost:8000
VITE_SENTRY_ENABLED=false
# Dev with proxy: VITE_SENTRY_BASE_URL=/sentry
# Direct: VITE_SENTRY_BASE_URL=http://localhost:8090
